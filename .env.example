# Optional: Set your production or custom inference API endpoint.
# If left unset or empty, NagarAI will seamlessly run on the built-in 6-model browser ensemble.
NEXT_PUBLIC_NAGARAI_API_URL=https://api.nagarai.org

# Used by the Python API when started from the ml directory.
NAGARAI_MODEL_PATH=artifacts/nagarai_ensemble.joblib
NAGARAI_REVIEW_THRESHOLD=0.48
